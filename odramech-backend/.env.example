# Copie para .env e ajuste
PORT=3004
DATABASE_URL=postgresql://postgres:Sop1503@localhost:5432/odramech?schema=odramech
JWT_SECRET=troque-este-segredo
JWT_EXPIRES=1.5h
# Duração da sessão após o login (horas)
SESSION_HOURS=4
FRONTEND_HOST=localhost
FRONTEND_PORT=4200
# Pasta dos anexos (opcional; padrão: ./uploads)
# UPLOAD_DIR=

# Endereço do sistema usado nos links dos e-mails (padrão: FRONTEND_HOST:FRONTEND_PORT)
# PUBLIC_APP_URL=https://app.suaoficina.com.br

# Chave para criptografar as senhas SMTP das empresas guardadas no banco (mín. 16 caracteres).
# Defina uma vez e não troque (trocar exige as empresas salvarem a senha SMTP de novo).
SECRETS_KEY=troque-por-uma-chave-longa-e-aleatoria

# E-mail (SMTP) PADRÃO do Odramech — usado pelas empresas que não configuraram SMTP próprio
# (Configurações → E-mail de envio). Sem SMTP_HOST os e-mails são só gerados em ./outbox
# Ex.: Gmail → smtp.gmail.com, porta 587, usuário = seu e-mail, senha = "senha de app" do Google
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sua Oficina <orcamentos@suaoficina.com.br>"
# Espera antes de mandar o e-mail de "orçamento atualizado" (junta edições seguidas)
QUOTE_UPDATE_EMAIL_DELAY_MINUTES=10
# Chrome/Edge para gerar o PDF (vazio = detecta o instalado; no Linux/Docker instale chromium)
# CHROME_PATH=

# Gerenciamento de Assinaturas Odramech
SUBSCRIPTIONS_URL=http://localhost:3010
SUBSCRIPTIONS_API_KEY=dev-odramech-subscriptions-key
# off | warn | block  (warn = só avisa; block = empresa inadimplente fica somente leitura)
SUBSCRIPTION_ENFORCEMENT=warn
SUBSCRIPTION_CACHE_TTL=60
