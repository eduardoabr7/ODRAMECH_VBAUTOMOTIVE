generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  gender         Gender
  email          String?  @unique
  password       String?
  /// senha definida por outra pessoa (cadastro feito pela oficina): troca obrigatória no primeiro acesso
  mustChangePassword Boolean @default(false) @map("must_change_password")
  principalPhone String   @map("principal_phone")
  secondaryPhone String?  @map("secondary_phone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  addressId      Int?     @unique @map("address_id")

  vehicles                UserVehicle[]
  address                 Address?          @relation(fields: [addressId], references: [id])
  userCorporation         UserCorporation[]
  workOrdersCreated       WorkOrder[]       @relation("WorkOrderCreatedBy")
  workOrdersEnded         WorkOrder[]       @relation("WorkOrderEndedBy")
  workOrdersAsClient      WorkOrder[]       @relation("WorkOrderClient")
  workOrdersAsResponsible WorkOrder[]       @relation("WorkOrderResponsible")
  appointmentCreateds     Appointment[]     @relation("UserAppointmentCreated")
  quotesAsClient          Quote[]           @relation("QuoteClient")
  quotesCreated           Quote[]           @relation("QuoteCreatedBy")
  paymentsRegistered      Payment[]         @relation("PaymentRegisteredBy")
  reviews                 Review[]          @relation("ReviewClient")
  notes                   UserNote[]

  @@map("cad_user")
}

model Enterprise {
  id        Int     @id @default(autoincrement())
  logoUrl   String?
  name      String
  email     String
  phone     String
  cnpj      String  @unique
  addressId Int     @unique

  address        Address                 @relation(fields: [addressId], references: [id])
  establishments Establishment[]
  users          UserCorporation[]
  branding       EnterpriseBranding?
  mailSettings   EnterpriseMailSettings?

  @@map("cad_enterprise")
}

model Establishment {
  id           Int     @id @default(autoincrement())
  logoUrl      String?
  name         String
  email        String?
  phone        String
  cnpj         String  @unique
  addressId    Int     @unique
  enterpriseId Int

  enterprise Enterprise              @relation(fields: [enterpriseId], references: [id])
  address    Address                 @relation(fields: [addressId], references: [id])
  users      UserCorporation[]
  workOrders WorkOrder[]
  counter    EstablishmentOsCounter?
  quotes     Quote[]
  notes      UserNote[]
  settings   EstablishmentSettings?
  parts      Part[]

  @@map("cad_establishment")
}

model Address {
  id           Int     @id @default(autoincrement())
  street       String
  number       String
  complement   String?
  district     String
  city         String
  zipCode      String
  country      String
  neighborhood String

  user          User?
  enterprise    Enterprise?
  establishment Establishment?

  @@map("cad_address")
}

model UserCorporation {
  idUser          Int
  idEnterprise    Int
  idEstablishment Int

  role   Role
  /// desativado = o usuário não consegue mais entrar neste estabelecimento
  active Boolean @default(true)

  user          User          @relation(fields: [idUser], references: [id])
  enterprise    Enterprise    @relation(fields: [idEnterprise], references: [id])
  establishment Establishment @relation(fields: [idEstablishment], references: [id])

  @@id([idUser, idEnterprise, idEstablishment])
  @@map("cad_user_corporation")
}

model WorkOrder {
  id                Int         @id @default(autoincrement())
  status            OrderStatus
  dateTimeCreation  DateTime    @default(now()) @map("date_time_creation")
  dateTimeEnd       DateTime?   @map("date_time_end") @db.Timestamptz(6)
  establishmentId   Int         @map("id_establishment")
  userCreationId    Int         @map("id_user_creation")
  userEndId         Int?        @map("id_user_end")
  userResponsibleId Int?        @map("id_user_responsible")
  clientId          Int         @map("id_client")
  vehicleId         Int         @map("id_vehicle")
  numberOs          Int         @map("number_os")

  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  userCreation    User          @relation("WorkOrderCreatedBy", fields: [userCreationId], references: [id])
  userEnd         User?         @relation("WorkOrderEndedBy", fields: [userEndId], references: [id])
  userResponsible User?         @relation("WorkOrderResponsible", fields: [userResponsibleId], references: [id])
  client          User          @relation("WorkOrderClient", fields: [clientId], references: [id])
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  appointments    Appointment[]
  items           ServiceItem[]
  payments        Payment[]
  quote           Quote?
  review          Review?

  @@unique([establishmentId, numberOs])
  @@map("work_orders")
}

model Appointment {
  id                Int             @id @default(autoincrement())
  dateTime          DateTime        @map("date_time") @db.Timestamptz(6)
  contentHtml       String          @map("content_html")
  userAppointmentId Int             @map("id_user_appointment")
  appointmentType   TypeAppointment @map("appointment_type")
  workOrderId       Int             @map("id_work_order")

  userAppointment User      @relation("UserAppointmentCreated", fields: [userAppointmentId], references: [id])
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id])

  archives ArchiveAppointment[]

  @@map("appointments")
}

model ArchiveAppointment {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @map("id_appointment")
  archiveType   ArchiveType @map("archive_type")
  url           String
  mimeType      String      @map("mime_type")
  originalName  String      @map("original_name")
  sizeBytes     Int         @map("size_bytes")
  createdAt     DateTime    @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("archive_appointment")
}

model UserVehicle {
  userId    Int
  vehicleId Int

  user    User    @relation(fields: [userId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([userId, vehicleId])
  @@map("cad_user_vehicle")
}

model Vehicle {
  id              Int     @id @default(autoincrement())
  plate           String  @unique
  km              String?
  modelYear       Int?
  manufactureYear Int?
  color           String?
  name            String
  make            String

  users      UserVehicle[]
  workOrders WorkOrder[]
  quotes     Quote[]

  @@map("cad_vehicle")
}

model EstablishmentOsCounter {
  establishmentId Int @id @map("id_establishment")
  lastNumberOs    Int @default(0) @map("last_number_os")
  lastNumberQuote Int @default(0) @map("last_number_quote")

  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@map("establishment_os_counter")
}

enum Role {
  ADMIN
  USER
  WORKER
  SUPERUSER
}

enum OrderStatus {
  PENDENTE
  EM_ATENDIMENTO
  AGUARDANDO_PECAS
  FINALIZADA
  CANCELADA
}

enum Gender {
  M
  F
  O
}

enum TypeAppointment {
  PUBLICO
  INTERNO
}

// ══════════════════════════════════════════════════════════
// Orçamentos, itens, pagamentos, avaliações e anotações
// ══════════════════════════════════════════════════════════

model Quote {
  id              Int         @id @default(autoincrement())
  numberQuote     Int         @map("number_quote")
  status          QuoteStatus @default(RASCUNHO)
  establishmentId Int         @map("id_establishment")
  clientId        Int         @map("id_client")
  vehicleId       Int         @map("id_vehicle")
  userCreationId  Int         @map("id_user_creation")
  workOrderId     Int?        @unique @map("id_work_order")
  validUntil      DateTime?   @map("valid_until")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  /// sobe a cada alteração de conteúdo (itens, observações, validade)
  version           Int       @default(1)
  /// link público do cliente (ver/aprovar/recusar), criado no primeiro envio
  publicToken       String?   @unique @map("public_token")
  /// quando e qual versão foi por e-mail (a mesma versão não é reenviada)
  emailSentAt       DateTime? @map("email_sent_at")
  emailSentVersion  Int?      @map("email_sent_version")
  /// envio automático agendado (espera 10 min pra juntar edições seguidas)
  emailPendingAt    DateTime? @map("email_pending_at")
  /// resposta do cliente pelo link (aprovou/recusou)
  clientRespondedAt DateTime? @map("client_responded_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  client        User          @relation("QuoteClient", fields: [clientId], references: [id])
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  userCreation  User          @relation("QuoteCreatedBy", fields: [userCreationId], references: [id])
  workOrder     WorkOrder?    @relation(fields: [workOrderId], references: [id])
  items         ServiceItem[]
  emails        QuoteEmail[]

  @@unique([establishmentId, numberQuote])
  @@index([emailPendingAt])
  @@map("quotes")
}

/// Histórico de e-mails de orçamento enviados ao cliente.
model QuoteEmail {
  id        Int               @id @default(autoincrement())
  quoteId   Int               @map("id_quote")
  version   Int
  kind      QuoteEmailKind
  trigger   QuoteEmailTrigger
  status    QuoteEmailStatus
  toEmail   String            @map("to_email")
  error     String?
  userId    Int?              @map("id_user")
  createdAt DateTime          @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@map("quote_emails")
}

enum QuoteEmailKind {
  ENVIO
  ATUALIZACAO
}

enum QuoteEmailTrigger {
  AUTOMATICO
  MANUAL
}

enum QuoteEmailStatus {
  ENVIADO
  /// sem SMTP configurado: o e-mail só foi salvo em arquivo (dev)
  SIMULADO
  FALHOU
}

model ServiceItem {
  id            Int      @id @default(autoincrement())
  kind          ItemKind
  description   String
  quantity      Decimal  @db.Decimal(10, 2)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  quoteId       Int?     @map("id_quote")
  workOrderId   Int?     @map("id_work_order")
  createdAt     DateTime @default(now()) @map("created_at")
  /// peça do estoque (módulo Estoque); só itens do tipo PECA
  partId        Int?     @map("id_part")
  /// quanto desta linha já saiu do estoque (a OS baixa; orçamento não). Mantém devoluções exatas.
  stockQuantity Decimal  @default(0) @map("stock_quantity") @db.Decimal(12, 2)

  quote     Quote?     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part?      @relation(fields: [partId], references: [id])

  @@index([quoteId])
  @@index([workOrderId])
  @@index([partId])
  @@map("service_items")
}

model Payment {
  id          Int           @id @default(autoincrement())
  workOrderId Int           @map("id_work_order")
  method      PaymentMethod
  amount      Decimal       @db.Decimal(10, 2)
  paidAt      DateTime      @default(now()) @map("paid_at")
  userId      Int           @map("id_user")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  user      User      @relation("PaymentRegisteredBy", fields: [userId], references: [id])

  @@index([workOrderId])
  @@map("payments")
}

model Review {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @unique @map("id_work_order")
  clientId    Int      @map("id_client")
  rating      Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  client    User      @relation("ReviewClient", fields: [clientId], references: [id])

  @@map("reviews")
}

model UserNote {
  userId          Int      @map("id_user")
  establishmentId Int      @map("id_establishment")
  content         String   @default("")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id])
  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@id([userId, establishmentId])
  @@map("user_notes")
}

enum QuoteStatus {
  RASCUNHO
  ENVIADO
  APROVADO
  RECUSADO
  EXPIRADO
}

enum ItemKind {
  PECA
  SERVICO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  BOLETO
}

enum ArchiveType {
  IMAGEM
  DOCUMENTO
  VIDEO
}

// Configurações: documento de orçamento e tema

/// Configurações por estabelecimento (documento de orçamento, validade, impressão).
model EstablishmentSettings {
  establishmentId           Int           @id @map("id_establishment")
  /// ODRAMECH | PREMIUM | CUSTOM (CUSTOM exige plano com QUOTE_DOCUMENT_EDITOR)
  quoteTemplate             QuoteTemplate @default(ODRAMECH) @map("quote_template")
  quoteHeaderHtml           String?       @map("quote_header_html")
  quoteBodyHtml             String?       @map("quote_body_html")
  quoteFooterHtml           String?       @map("quote_footer_html")
  quoteValidityDays         Int           @default(15) @map("quote_validity_days")
  markQuoteSentOnPrint      Boolean       @default(false) @map("mark_quote_sent_on_print")
  /// manda o PDF pro e-mail do cliente ao salvar (e nas atualizações)
  autoEmailQuote            Boolean       @default(false) @map("auto_email_quote")
  /// cliente pode escrever (e anexar fotos) na OS — só apontamentos públicos; só admin altera
  clientAppointmentsEnabled Boolean       @default(false) @map("client_appointments_enabled")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@map("establishment_settings")
}

/// Tema da empresa: logo, nome, cor de destaque e tela de login.
model EnterpriseBranding {
  enterpriseId  Int      @id @map("id_enterprise")
  /// chave pública usada no link de login com a marca (/login?marca=<chave>)
  publicKey     String   @unique @default(uuid()) @map("public_key")
  displayName   String?  @map("display_name")
  /// imagens em data URL (PNG/JPG/WebP/SVG), tamanho limitado no backend
  logoUrl       String?  @map("logo_url")
  accentColor   String?  @map("accent_color")
  loginImageUrl String?  @map("login_image_url")
  loginHeadline String?  @map("login_headline")
  loginSubtitle String?  @map("login_subtitle")
  updatedAt     DateTime @updatedAt @map("updated_at")

  enterprise Enterprise @relation(fields: [enterpriseId], references: [id])

  @@map("enterprise_branding")
}

enum QuoteTemplate {
  ODRAMECH
  PREMIUM
  CUSTOM
}

/// SMTP próprio da empresa, vale pra todos os estabelecimentos. Sem ele usa o padrão do .env.
model EnterpriseMailSettings {
  enterpriseId      Int       @id @map("id_enterprise")
  enabled           Boolean   @default(false)
  host              String
  port              Int       @default(587)
  /// true = SSL/TLS direto (porta 465); false = STARTTLS (587)
  secure            Boolean   @default(false)
  username          String?
  /// criptografada (AES-256-GCM), nunca volta pro navegador
  passwordEncrypted String?   @map("password_encrypted")
  fromName          String?   @map("from_name")
  fromEmail         String    @map("from_email")
  /// último teste de envio
  verifiedAt        DateTime? @map("verified_at")
  lastError         String?   @map("last_error")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  enterprise Enterprise @relation(fields: [enterpriseId], references: [id])

  @@map("enterprise_mail_settings")
}

/// Última decisão de acesso conhecida de cada empresa (vinda do serviço de assinaturas).
/// Se o serviço cair, quem estava bloqueado continua bloqueado — a "falha aberta" vale só para quem nunca foi visto.
model SubscriptionAccessSnapshot {
  enterpriseId Int      @id @map("enterprise_id")
  decision     Json
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("subscription_access_snapshot")
}

// ══════════════════════════════════════════════════════════
// Módulo ESTOQUE DE PEÇAS (contrato à parte — ver ModuleAccessGuard)
// Estoque é físico: cada estabelecimento tem o seu.
// ══════════════════════════════════════════════════════════

model Part {
  id              Int      @id @default(autoincrement())
  establishmentId Int      @map("id_establishment")
  /// código interno da oficina (único no estabelecimento quando informado)
  code            String?
  name            String
  brand           String?
  /// código do fabricante / OEM
  oemCode         String?  @map("oem_code")
  /// UN | PC | PAR | JG | KIT | L | ML | KG | G | M | CX
  unit            String   @default("UN")
  costPrice       Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  salePrice       Decimal  @default(0) @map("sale_price") @db.Decimal(10, 2)
  /// saldo atual — só muda junto com um StockMovement (mesma transação)
  quantity        Decimal  @default(0) @db.Decimal(12, 2)
  minQuantity     Decimal  @default(0) @map("min_quantity") @db.Decimal(12, 2)
  location        String?
  notes           String?
  /// desativada some das buscas, mas o histórico fica (nunca se apaga uma peça)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment   @relation(fields: [establishmentId], references: [id])
  movements     StockMovement[]
  serviceItems  ServiceItem[]

  @@unique([establishmentId, code])
  @@index([establishmentId, active, name])
  @@map("inv_parts")
}

/// Livro-razão do estoque: toda mudança de saldo gera uma linha (imutável).
model StockMovement {
  id              Int               @id @default(autoincrement())
  partId          Int               @map("id_part")
  establishmentId Int               @map("id_establishment")
  type            StockMovementType
  /// variação com sinal (+ entrou, − saiu)
  quantity        Decimal           @db.Decimal(12, 2)
  /// saldo logo depois do movimento
  balanceAfter    Decimal           @map("balance_after") @db.Decimal(12, 2)
  /// custo unitário informado na entrada
  unitCost        Decimal?          @map("unit_cost") @db.Decimal(10, 2)
  note            String?
  workOrderId     Int?              @map("id_work_order")
  /// linha da OS que originou (sem FK: a linha pode ser apagada, o histórico não)
  serviceItemId   Int?              @map("id_service_item")
  userId          Int               @map("id_user")
  createdAt       DateTime          @default(now()) @map("created_at")

  part Part @relation(fields: [partId], references: [id])

  @@index([partId, createdAt])
  @@index([establishmentId, createdAt])
  @@index([workOrderId])
  @@map("inv_stock_movements")
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  /// baixa automática por item de OS
  OS_BAIXA
  /// devolução automática (item removido/reduzido, OS cancelada)
  OS_ESTORNO
}

/// Última situação conhecida dos módulos contratados (se o serviço de assinaturas cair,
/// quem tinha o módulo continua com ele; quem nunca foi visto fica sem — é um adicional pago).
model ModuleAccessSnapshot {
  enterpriseId Int      @id @map("enterprise_id")
  modules      Json
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("module_access_snapshot")
}
