# Gerenciamento de Assinaturas Odramech — copie para .env
PORT=3010
DATABASE_URL=postgresql://postgres:Sop1503@localhost:5432/odramech_assinaturas?schema=assinaturas

# Chave compartilhada com o backend principal (header x-api-key)
API_KEY=dev-odramech-subscriptions-key

# Para onde avisar mudanças de assinatura (o backend limpa o cache)
MAIN_BACKEND_WEBHOOK_URL=http://localhost:3004/internal/subscription-events
# Base do backend da oficina (o painel lista as empresas por aqui). Vazio = deriva do webhook acima.
# MAIN_BACKEND_URL=http://localhost:3004

# Provedor de pagamento: sandbox (simulado, sem dinheiro real).
# Com NODE_ENV=production e sandbox, NENHUM pagamento é processado (ninguém "paga" de mentira).
PAYMENT_PROVIDER=sandbox
# Segredo HMAC do webhook do sandbox (header x-sandbox-signature). Em produção: 32+ caracteres aleatórios.
SANDBOX_WEBHOOK_SECRET=sandbox-dev-webhook-secret

# production | (vazio = desenvolvimento). Em produção API_KEY e segredos de exemplo são recusados.
NODE_ENV=

# Painel administrativo (odramech-admin): duração da sessão em horas
ADMIN_SESSION_HOURS=8

# Regras de cobrança
TRIAL_DAYS=7
GRACE_DAYS=7
RENEWAL_LEAD_DAYS=5
SCHEDULER_INTERVAL_SECONDS=60
# Plano do teste grátis: BASIC | INTERMEDIARIO | PRO | ULTRA
DEFAULT_PLAN_CODE=INTERMEDIARIO
