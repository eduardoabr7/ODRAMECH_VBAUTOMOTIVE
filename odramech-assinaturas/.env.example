# Gerenciamento de Assinaturas Odramech — copie para .env
PORT=3010
DATABASE_URL=postgresql://postgres:Sop1503@localhost:5432/odramech_assinaturas?schema=assinaturas

# Chave compartilhada com o backend principal (header x-api-key)
API_KEY=dev-odramech-subscriptions-key

# Para onde avisar mudanças de assinatura (o backend limpa o cache)
MAIN_BACKEND_WEBHOOK_URL=http://localhost:3004/internal/subscription-events

# Provedor de pagamento: sandbox (simulado, sem dinheiro real)
PAYMENT_PROVIDER=sandbox

# Regras de cobrança
TRIAL_DAYS=14
GRACE_DAYS=7
RENEWAL_LEAD_DAYS=5
SCHEDULER_INTERVAL_SECONDS=60
